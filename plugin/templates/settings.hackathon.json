{
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push * main)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(npm run build *)",
      "Bash(npx nx build *)",
      "Bash(npx nx affected -t build *)",
      "Bash(npx nx run *:deploy-local *)",
      "Bash(npx cdk deploy *)"
    ]
  }
}
