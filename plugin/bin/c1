#!/usr/bin/env node
'use strict';
const path = require('node:path');
const { pathToFileURL } = require('node:url');

const major = Number(process.versions.node.split('.')[0]);
if (major < 22) {
  process.stderr.write(`c1 needs Node.js 22 or newer (found ${process.versions.node}).\n`);
  process.exit(1);
}

import(pathToFileURL(path.join(__dirname, '..', 'lib', 'cli.mjs')).href)
  .then(({ main }) => main(process.argv.slice(2)))
  .then(
    (code) => {
      process.exitCode = code ?? 0;
    },
    (e) => {
      process.stderr.write(`c1: ${e && e.stack ? e.stack : e}\n`);
      process.exitCode = 1;
    },
  );
